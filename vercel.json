{
  "rewrites": [
    {
      "source": "/api/payments/deuna/:endpoint*",
      "destination": "/api/payments/deuna"
    },
    {
      "source": "/api/gdrive-:action*",
      "destination": "/api/gdrive"
    }
  ],
  "redirects": [
    {
      "source": "/.env",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/firebase-adminsdk.json",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/sri_contingency.db",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/package.json",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/package-lock.json",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/vercel.json",
      "destination": "/404",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache, no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
