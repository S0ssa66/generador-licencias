# BEATSS server configuration (never commit real values)
GEMINI_API_KEY=
LOCAL_AUTH_TOKEN=
LLM_PROVIDER=gemini

# Required by every production download/delivery endpoint.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_KEY=

# Keep payment mocks disabled outside local development.
ALLOW_PAYMENT_MOCKS=false

# Firebase Admin credentials used by Vercel serverless functions.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: explicit public origin for CORS allow-listing.
ALLOWED_ORIGIN=https://beatss.app
