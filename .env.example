# BEATSS server configuration (never commit real values)
# Values: auto, opencode, openai, openai-compatible, gemini, ollama, lm-studio
GEMINI_API_KEY=
LOCAL_AUTH_TOKEN=
LLM_PROVIDER=auto

# OpenAI uses a separate API key/project from a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Any Chat Completions-compatible server. Use HTTPS, or localhost for local models.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=local-model

# Keep false to avoid silently sending private context between cloud providers.
LLM_ALLOW_CLOUD_FALLBACK=false

# Uses the local OpenCode CLI and its own authenticated provider session.
OPENCODE_MODEL=deepseek/deepseek-v4-flash
OPENCODE_AGENT=knowledge-steward

# Required by every production download/delivery endpoint.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_KEY=

# Keep payment mocks disabled outside local development.
ALLOW_PAYMENT_MOCKS=false

# Firebase Admin credentials used by Vercel serverless functions.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Drive central for large producer assets. Keep the OAuth client in the
# existing Google Cloud project; only the authorized Drive account changes.
# The Client Secret and refresh token are server-only values and must never be
# entered in the browser.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ALLOWED_EMAIL=sossamusic@gmail.com
GOOGLE_DRIVE_ROOT_FOLDER=BEATSS Platform

# Optional comma-separated platform administrators in addition to Firebase's
# custom admin claim and the historical BEATSS administrator.
BEATSS_ADMIN_EMAILS=

# Stripe. The platform producer (Sossa) is the only seller enabled today.
# External producers stay disabled until EXTERNAL_PRODUCERS_ENABLED=true. The
# planned model is BEATSS as central seller (C) + subscription (B), with the
# producer_gateway (A) mode opt-in per producer. No Stripe Connect is used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_PRODUCER_ID=

# External producer sales (architecture C+B with A opt-in). Keep false until the
# full flow (settlement, commission, SRI) is reviewed and authorized. Commission
# defaults: 15% on the free `inicial` plan, 5% on paid plans; producer_gateway
# mode uses 0% platform commission.
EXTERNAL_PRODUCERS_ENABLED=false

# EmailJS delivery identifiers for the BEATSS platform account. These are
# paired with the server-only private key configured in Vercel.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional payment providers. Leave empty to keep each method disabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
DEUNA_WEBHOOK_SECRET=

# Optional: explicit public origin for CORS allow-listing.
ALLOWED_ORIGIN=https://beatss.app
