rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar si el usuario es administrador.
    function isAdmin() {
      return request.auth != null &&
             'admin' in request.auth.token &&
             request.auth.token.admin == true;
    }

    // Función auxiliar para validar datos de contacto públicos (leads)
    function isValidContact() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'email', 'id', 'phone', 'city', 'country', 'updatedAt', 'source']) &&
             data.email is string && data.email.size() < 100 &&
             data.name is string && data.name.size() < 100 &&
             (!('id' in data) || (data.id is string && data.id.size() < 50)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 30)) &&
             (!('city' in data) || (data.city is string && data.city.size() < 50)) &&
             (!('country' in data) || (data.country is string && data.country.size() < 50)) &&
             (!('source' in data) || (data.source is string && data.source.size() < 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is number));
    }

    // Función auxiliar para validar datos de whitelist para evitar abuso de almacenamiento
    function isValidWhitelistEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['channelUrl', 'artistName', 'songName', 'licenseRef', 'createdAt']) &&
             data.channelUrl is string && data.channelUrl.size() < 150 &&
             data.artistName is string && data.artistName.size() < 100 &&
             data.songName is string && data.songName.size() < 150 &&
             data.licenseRef is string && data.licenseRef.size() < 100 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() < 50));
    }

    // Los pagos de suscripción manuales requieren sesión y quedan pendientes
    // hasta que un administrador valide el comprobante.
    function isValidSubscriptionPayment() {
      let data = request.resource.data;
      return request.auth != null &&
             data.keys().hasOnly([
               'type', 'userId', 'userEmail', 'aka', 'method', 'reference',
               'status', 'plan', 'receiptUrl', 'timestamp', 'needInvoice',
               'invoiceRuc', 'invoiceCompany', 'invoiceAddress', 'invoiceEmail'
             ]) &&
             data.keys().hasAll([
               'type', 'userId', 'userEmail', 'method', 'reference',
               'status', 'plan', 'receiptUrl', 'timestamp'
             ]) &&
             data.type == 'subscription_payment' &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail == request.auth.token.email && data.userEmail.size() < 254 &&
             data.aka is string && data.aka.size() < 160 &&
             data.method in ['PayPal', 'Deuna!', 'Banco Pichincha', 'Banco Guayaquil', 'PayPhone'] &&
             data.reference is string && data.reference.size() > 0 && data.reference.size() < 160 &&
             data.status == 'pending' &&
             data.plan in ['pro', 'enterprise'] &&
             data.receiptUrl is string && data.receiptUrl.size() > 0 && data.receiptUrl.size() < 2048 &&
             data.receiptUrl.matches('https://firebasestorage.googleapis.com/v0/b/[^/]+/o/receipts%2Fsaas%2F.*') &&
             data.timestamp is string && data.timestamp.size() < 80 &&
             (!('needInvoice' in data) || data.needInvoice is bool) &&
             (!('invoiceRuc' in data) || (data.invoiceRuc is string && data.invoiceRuc.size() == 13)) &&
             (!('invoiceCompany' in data) || (data.invoiceCompany is string && data.invoiceCompany.size() < 160)) &&
             (!('invoiceAddress' in data) || (data.invoiceAddress is string && data.invoiceAddress.size() < 240)) &&
             (!('invoiceEmail' in data) || (data.invoiceEmail is string && data.invoiceEmail.size() < 254)) &&
             (!('needInvoice' in data) || data.needInvoice == false || (
               data.needInvoice == true &&
               data.keys().hasAll(['invoiceRuc', 'invoiceCompany', 'invoiceAddress', 'invoiceEmail']) &&
               data.invoiceRuc.size() == 13 &&
               data.invoiceCompany.size() > 0 &&
               data.invoiceAddress.size() > 0 &&
               data.invoiceEmail.size() > 0
             ));
    }

    // Regla para la contabilidad consolidada de Sossa Admin (Collection Group query)
    match /{path=**}/licencias/{document} {
      allow read: if isAdmin();
    }

    // Regla para consulta global de beats (Catálogo Global)
    match /{path=**}/beats/{document} {
      allow read: if true;
    }

    // Las compras públicas se crean exclusivamente en el servidor. El cliente
    // autenticado solo puede registrar un comprobante manual de suscripción.
    match /payments/{paymentId} {
      allow create: if isValidSubscriptionPayment();
      
      // El estado para invitados se consulta mediante /api/payments/status,
      // que exige una credencial opaca y nunca devuelve PII.
      allow get: if (request.auth != null && (
                      (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
                      resource.data.producerId == request.auth.uid || 
                      isAdmin()
                    ));
      
      // Restringir el listado ('list') de pagos solo a los involucrados autenticados
      allow list: if request.auth != null && (
                    resource.data.userId == request.auth.uid || 
                    resource.data.producerId == request.auth.uid || 
                    isAdmin()
                  );
      
      allow update: if (
                      request.auth != null && (
                        isAdmin() || 
                        (resource.data.producerId == request.auth.uid && 
                         resource.data.status == 'pending' &&
                         request.resource.data.status in ['approved', 'rejected', 'cancelled', 'cancelado'] &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                      )
                    );
      allow delete: if false;
    }

    // Regla para referidos (referrals)
    match /referrals/{referralId} {
      allow read: if request.auth != null && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
                       request.auth.uid == referralId &&
                       request.resource.data.referrerId != request.auth.uid &&
                       (!('converted' in request.resource.data) || request.resource.data.converted == false);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Regla para códigos VIP
    match /vip_codes/{codeId} {
      allow get: if isAdmin();
      allow list, write: if isAdmin();
    }

    // Reglas para la cola de tareas asíncronas (tasks)
    match /tasks/{taskId} {
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid &&
                       (!('estado' in request.resource.data) || request.resource.data.estado == 'pending');
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (
                       isAdmin() || 
                       (resource.data.userId == request.auth.uid && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado', 'resultado', 'progreso', 'tipo', 'consulta']))
                     );
      allow delete: if isAdmin();
    }

    // Regla principal por usuario
    match /users/{userId} {
      // Sossa Admin tiene acceso completo
      allow read, write: if isAdmin();

      // El propio usuario puede leer su documento
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // El propio usuario puede crear/actualizar su documento principal con restricciones de plan y códigos
      allow create: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.keys().hasAny(['plan', 'planActivatedAt', 'expirationPro', 'redeemedCodes']) || request.resource.data.plan == 'inicial'
      );
      allow update: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planActivatedAt', 'expirationPro', 'redeemedCodes']) || 
        (request.resource.data.plan == 'inicial' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planActivatedAt', 'expirationPro', 'redeemedCodes']))
      );

      // La configuración del productor contiene identidad y preferencias del
      // negocio. La tienda pública accede a una proyección saneada del servidor.
      match /config/producer {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId &&
          !request.resource.data.keys().hasAny(['signature', 'dsClientId', 'dsAccountId', 'dsEnv', 'gdriveClientId', 'emailjsServiceId', 'emailjsTemplateId', 'emailjsTemplatePendingId', 'emailjsPublicKey', 'paypalClientSecret', 'sriP12Password', 'sriP12Base64', 'sriSecuencial', 'audioTagBase64', 'bankPichinchaAcc', 'bankPichinchaDni', 'bankPichinchaName', 'bankPichinchaType', 'bankGuayaquilAcc', 'bankGuayaquilDni', 'bankGuayaquilName', 'bankGuayaquilType', 'deunaName', 'deunaPhone', 'deunaQrBase64', 'paypalClientId', 'paypalEmail', 'paypalPlanIdPro', 'paypalPlanIdElite', 'paypalPlanIdCreator', 'paypalPlanIdProArtist', 'payphoneAppId', 'payphoneClientId', 'payphonePhone', 'stripePublishableKey', 'stripeConnectAccountId', 'id', 'address', 'birthdate', 'sriRuc', 'sriRazonSocial', 'sriNombreComercial', 'sriDirMatriz', 'sriEstab', 'sriPtoEmi', 'sriAmbiente', 'sriRimpe', 'sriContabilidad', 'sriIvaTarifa', 'sriIvaIncluido', 'sriRucProveedor']) && (
          !request.resource.data.keys().hasAny(['plan', 'expirationPro', 'redeemedCodes']) || 
          request.resource.data.plan == 'inicial'
        );
        // Se permite eliminar campos heredados para migrarlos a private_config,
        // pero el documento resultante nunca puede conservarlos ni recrearlos.
        allow update: if !request.resource.data.keys().hasAny(['signature', 'dsClientId', 'dsAccountId', 'dsEnv', 'gdriveClientId', 'emailjsServiceId', 'emailjsTemplateId', 'emailjsTemplatePendingId', 'emailjsPublicKey', 'paypalClientSecret', 'sriP12Password', 'sriP12Base64', 'sriSecuencial', 'audioTagBase64', 'bankPichinchaAcc', 'bankPichinchaDni', 'bankPichinchaName', 'bankPichinchaType', 'bankGuayaquilAcc', 'bankGuayaquilDni', 'bankGuayaquilName', 'bankGuayaquilType', 'deunaName', 'deunaPhone', 'deunaQrBase64', 'paypalClientId', 'paypalEmail', 'paypalPlanIdPro', 'paypalPlanIdElite', 'paypalPlanIdCreator', 'paypalPlanIdProArtist', 'payphoneAppId', 'payphoneClientId', 'payphonePhone', 'stripePublishableKey', 'stripeConnectAccountId', 'id', 'address', 'birthdate', 'sriRuc', 'sriRazonSocial', 'sriNombreComercial', 'sriDirMatriz', 'sriEstab', 'sriPtoEmi', 'sriAmbiente', 'sriRimpe', 'sriContabilidad', 'sriIvaTarifa', 'sriIvaIncluido', 'sriRucProveedor']) && (isAdmin() || (
          request.auth != null && request.auth.uid == userId && (
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'expirationPro', 'redeemedCodes'])) ||
            (request.resource.data.plan == 'inicial' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['expirationPro', 'redeemedCodes']))
          )
        ));
      }

      // Reglas para subcolección private_config/producer
      match /private_config/producer {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // La firma electrónica y su contraseña no pueden volver al navegador,
      // ni siquiera al propietario. Sólo los procesos server-side con Admin
      // SDK acceden a este documento.
      match /private_config/sri {
        allow read, write: if false;
      }

      // Reglas para subcolecciones normales
      match /beats/{beatId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

        // Enlaces de descarga privados y protegidos
        match /private/files {
          allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }

      match /templates/{templateId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /licencias/{licenciaId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /whitelist/{whitelistId} {
        allow read, delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow create: if ((request.auth != null && request.auth.uid == userId) || isAdmin()) &&
                      isValidWhitelistEntry();
        allow update: if false;
      }

      match /contacts/{contactId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null &&
                              (request.auth.uid == userId || isAdmin()) &&
                              isValidContact();
      }

      // Historial privado de correos y archivos entregados por el productor.
      match /email_logs/{logId} {
        allow read, create, update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
